{
  "name": "osu-beatmap-renderer",
  "version": "0.2.0",
  "description": "Standalone osu! beatmap renderer powered by PixiJS. Parses .osu files and renders hit objects with hitsounds.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inix1257/osu-beatmap-renderer.git"
  },
  "homepage": "https://github.com/inix1257/osu-beatmap-renderer#readme",
  "bugs": {
    "url": "https://github.com/inix1257/osu-beatmap-renderer/issues"
  },
  "type": "module",
  "main": "dist/osu-beatmap-renderer.js",
  "module": "dist/osu-beatmap-renderer.js",
  "exports": {
    ".": {
      "import": "./dist/osu-beatmap-renderer.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite --config vite.demo.config.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "peerDependencies": {
    "pixi.js": ">=7.0.0"
  },
  "devDependencies": {
    "pixi.js": "^8.6.6",
    "vite": "^6.3.1"
  },
  "keywords": [
    "osu",
    "beatmap",
    "renderer",
    "pixi",
    "pixijs"
  ],
  "license": "MIT"
}
